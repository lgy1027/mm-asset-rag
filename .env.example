# ═══════════════════════════════════════════════════════════════════════════
# mm-asset-rag 快速上手模板
# 用法:cp .env.example .env,然后填下面 ①-③ 的必填项即可跑起来。
# 其余全部走代码默认值;需要调优时查阅 docs/configuration.md(全量参考)。
# 注意:行内注释以"空格 + #"开头,值与注释之间至少留一个空格。
# ═══════════════════════════════════════════════════════════════════════════

# ─── 数据目录(可选,默认 ~/.mm_asset_rag)────────────────────────────────
# MM_ASSET_RAG_HOME=~/.mm_asset_rag

# ─── ① 文本 Embedding(必填)────────────────────────────────────────────
# OpenAI 兼容 /v1/embeddings;本地 ollama 示例:
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3:latest

# ─── ② LLM(可选,不配则没有 rewrite/answer/caption 等 LLM 能力)────────
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# VLM 视觉模型(可选;配了才能给图片/视频生成描述)
# VLM_API_KEY=
# VLM_BASE_URL=
# VLM_MODEL=

# ─── ③ 向量库(可选,默认本地文件模式,零依赖)──────────────────────────
# QDRANT_URL=http://127.0.0.1:6333

# ─── 常用开关(默认值的就不列了,见 docs/configuration.md)──────────────
# ENABLE_OCR=true                    # 图片 OCR([ocr] extra)
# ENABLE_VLM=true                    # 解析图片/视频时调 VLM
# RERANKER_ENABLED=true              # 二阶段精排(复用 MODEL_API_KEY,或用 RERANKER_* 单独指定)
# QUERY_REWRITE_ENABLED=true         # LLM 多路改写检索
# TRACING_PROVIDER=langfuse          # 接入 Langfuse 追踪(自托管见 scripts/)

# ─── 对外部署(本地 127.0.0.1 开发留空即可)──────────────────────────────
# MMRAG_API_TOKEN=                   # API 访问令牌
# MMRAG_TRUSTED_HOSTS=               # 信任的公网域名
