# mm-asset-rag — minimal deployment configuration
#
# Copy this file to .env. Start with the model connections and embedding model;
# all other entries are optional. Advanced tuning is documented in
# docs/configuration.md and is intentionally not duplicated here.

# ─── Shared model connection ──────────────────────────────────────────────
# LLM, VLM and text embedding inherit this OpenAI-compatible connection.
MODEL_API_KEY=
MODEL_BASE_URL=

# ─── Required RAG model ──────────────────────────────────────────────────
# Text embedding must be configured before indexing/searching.
EMBEDDING_MODEL=
# Set these only when embedding uses another provider.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ─── Optional generation models ──────────────────────────────────────────
# LLM powers /answer, /chat and query rewrite.
LLM_MODEL=
# VLM powers upload metadata and embedded-figure captions.
# VLM_MODEL=
# VLM_API_KEY=
# VLM_BASE_URL=

# ─── Optional image embedding ────────────────────────────────────────────
# Install [clip] or [cn_clip] before enabling image retrieval.
# IMAGE_PROVIDER=clip              # clip | cn_clip
# CLIP_MODEL=clip-ViT-B-32

# ─── Optional reranker ───────────────────────────────────────────────────
# RERANKER_ENABLED=true
# RERANKER_PROVIDER=siliconflow    # siliconflow | dashscope
# RERANKER_API_MODEL=
# RERANKER_API_KEY=                # defaults to MODEL_API_KEY
# RERANKER_API_BASE=

# ─── RAG policies ────────────────────────────────────────────────────────
# Profiles set cost/quality defaults only when an individual advanced option
# is absent. Existing explicit variables always win.
# INGESTION_PROFILE=balanced       # fast | balanced | precision
# RETRIEVAL_PROFILE=balanced       # fast | balanced | precision
#
# fast ingestion: avoids optional metadata, image extraction and scan fallback.
# precision ingestion: smaller chunks with more overlap and scan fallback.
# precision retrieval: enables configured reranking, query rewrite and
# intent-aware retrieval. Missing provider credentials still degrade safely.

# ─── Storage backend ──────────────────────────────────────────────────────
# MM_ASSET_RAG_HOME=~/.mm_asset_rag
# VECTOR_BACKEND=qdrant
# QDRANT_URL=                       # unset = local embedded Qdrant
# QDRANT_API_KEY=
# QDRANT_TEXT_COLLECTION=multimodal_text
# QDRANT_IMAGE_COLLECTION=multimodal_image

# ─── Parsing capabilities ─────────────────────────────────────────────────
# PDF_PARSER=auto                   # auto | pymupdf | paddleocr_vl | docling | ppocr
# DOCUMENT_PARSER=markitdown        # markitdown | docling
# ENABLE_OCR=false
# OCR_BACKEND=local                 # local | http
# ENABLE_VLM=false
# AUTO_META_ENABLED=true
# IMAGE_CAPTION_ENABLED=false

# ─── API and deployment safety ────────────────────────────────────────────
# MMRAG_API_TOKEN=                  # required outside loopback development
# MMRAG_TRUSTED_HOSTS=              # set public host(s) with the token
# MMRAG_API_HOST=127.0.0.1
# MMRAG_API_PORT=8011
